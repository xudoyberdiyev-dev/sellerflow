# Nusxa oling:  cp .env.example .env   — va qiymatlarni to'ldiring.
# .env fayli GIT'ga TUSHMAYDI (.gitignore). Token va parollarni hech qachon chat, screenshot yoki kodga yozmang.

# @BotFather bergan token
TELEGRAM_BOT_TOKEN=

# PostgreSQL paroli (uzun tasodifiy qiymat). Masalan: openssl rand -hex 24
DB_USER=sellerflow
DB_PASSWORD=

# Birinchi Superadmin (faqat bazada birorta ham admin bo'lmaganda yaratiladi).
# Parol kamida 12 belgi. Birinchi kirishda 2FA (Google Authenticator) ulanadi.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Favqulodda tiklash (break-glass) — FAQAT kerak bo'lganda to'ldiring, tiklangach o'chiring.
# Shu email'li admin: faol SUPERADMIN, parol shu qiymatga, 2FA va blok tiklanadi, sessiyalar bekor (docs/OPERATIONS.md §4C).
ADMIN_RECOVERY_EMAIL=
ADMIN_RECOVERY_PASSWORD=

# Ixtiyoriy: /help ichidagi qo'llab-quvvatlash kontakti (@username yoki https havola).
# Keyin admin paneldan ham o'zgartirish mumkin.
SUPPORT_LABEL=Qo‘llab-quvvatlash
SUPPORT_URL=

# Xizmat shartlari versiyasi (terms_uz.txt o'zgarsa oshiring — qayta rozilik so'raladi)
TERMS_VERSION=2026-11-05-v0.1

# 30 kunlik o'chirish davridan keyin tijoriy ma'lumotni ham o'chirish (yurist tasdiqlaguncha false)
DELETION_PURGE_DATA=false

# Backup necha kun saqlansin (eng yangi 7 nusxa baribir doim qoladi)
BACKUP_KEEP_DAYS=14

# MAJBURIY (production): backup shifrlash paroli (gpg AES256) -> sellerflow_*.dump.gpg. Berilmasa backup XATO beradi.
# Parolni .env dan TASHQARIDA ham (parol menejerida) saqlang — usiz backupni tiklab bo'lmaydi. Masalan: openssl rand -hex 32
BACKUP_ENCRYPTION_PASSPHRASE=
# Faqat lokal sinov uchun: shifrlanmagan backupga ataylab ruxsat (true). Production'da bo'sh qoldiring.
BACKUP_ALLOW_PLAINTEXT=

# Tavsiya etiladi (production'da majburiy deb hisoblang): backup xatosi yoki eskirishi haqida bot shu chat'ga yozadi (sizning Telegram ID yoki guruh ID).
# ID'ni bilish: @userinfobot. Avval botga /start yuboring, aks holda bot sizga yoza olmaydi.
ALERT_TELEGRAM_CHAT_ID=
