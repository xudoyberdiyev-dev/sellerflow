# Nusxa oling:  cp .env.example .env   — va qiymatlarni to'ldiring.
# .env fayli GIT'ga TUSHMAYDI (.gitignore). Tokenni hech qachon chat, screenshot yoki kodga yozmang.

# @BotFather bergan token
TELEGRAM_BOT_TOKEN=

# PostgreSQL paroli (uzun tasodifiy qiymat qo'ying)
DB_USER=sellerflow
DB_PASSWORD=

# Admin API kaliti (bo'sh qolsa admin API yopiq). Masalan: openssl rand -hex 32
ADMIN_API_KEY=

# Ixtiyoriy: /help ichidagi qo'llab-quvvatlash kontakti (@username yoki https havola)
SUPPORT_LABEL=Qo‘llab-quvvatlash
SUPPORT_URL=
